<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Out-of-editor test harness for Kordon.Core.

    Kordon.Core is deliberately free of UnityEngine references (see
    Assets/_Project/Scripts/Core/Kordon.Core.asmdef -> "noEngineReferences": true),
    so every game rule - 50 kill victory, magazine/reload/inspect behaviour,
    ammo hiding, damage/penetration, respawn, match end, anti-cheat validators -
    can be compiled and executed by plain `dotnet test`, with no Unity editor
    and no Unity licence.  The very same tests also run inside Unity through
    Assets/_Project/Scripts/Tests/EditMode (Unity Test Framework), which links
    against the identical source files.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Kordon.Core.Tests</AssemblyName>
    <RootNamespace>Kordon.Core.Tests</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**/*.cs;obj/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Core/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped data files live in StreamingAssets so the standalone build and the
         dedicated server can read them with plain file IO.  Tests link the very same
         files, which keeps one single source of truth. -->
    <None Include="../../Assets/StreamingAssets/Data/**/*.json" LinkBase="Data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
